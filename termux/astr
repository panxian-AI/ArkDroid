#!/data/data/com.termux/files/usr/bin/bash
# AstrBot 在 Termux 里的托管命令：astr start|stop|restart|status|log|shell|update|uninstall
set -uo pipefail

STATE_DIR="$HOME/.arkdroid"
DISTRO="${ARKDROID_DISTRO:-ubuntu}"
SESSION="astrbot"
PANEL_PORT="${ASTRBOT_PORT:-6185}"

if [ -f "$STATE_DIR/config" ]; then
  # shellcheck disable=SC1091
  . "$STATE_DIR/config"
fi

say()  { printf '\033[1;34m%s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
bad()  { printf '\033[1;31m✗ %s\033[0m\n' "$*"; }

panel_code() {
  curl -s -o /dev/null -m 3 -w '%{http_code}' "http://127.0.0.1:${PANEL_PORT}/" 2>/dev/null || echo "000"
}

in_distro() {
  proot-distro login "$DISTRO" --shared-tmp -- /bin/bash -lc "$1"
}

has_session() {
  in_distro "tmux has-session -t $SESSION 2>/dev/null"
}

case "${1:-}" in
  start)
    if has_session; then
      ok "已经在跑了（astr log 看输出）"
      exit 0
    fi
    say "启动 AstrBot…"
    in_distro "cd /root/AstrBot && tmux new-session -d -s $SESSION 'uv run main.py 2>&1 | tee -a /root/astrbot.log'" \
      || { bad "创建会话失败"; exit 1; }

    printf '等面板起来'
    for _ in $(seq 1 40); do
      sleep 1
      printf '.'
      code=$(panel_code)
      if [ "$code" != "000" ] && [ "$code" != "502" ]; then
        printf '\n'
        ok "面板已就绪：http://127.0.0.1:${PANEL_PORT}  (HTTP $code)"
        exit 0
      fi
    done
    printf '\n'
    bad "40 秒内面板没起来，astr log 看原因"
    exit 1
    ;;

  stop)
    if ! has_session; then
      ok "本来就没在跑"
      exit 0
    fi
    in_distro "tmux send-keys -t $SESSION C-c 2>/dev/null; sleep 2; tmux kill-session -t $SESSION 2>/dev/null; true"
    ok "已停止"
    ;;

  restart)
    "$0" stop
    sleep 1
    exec "$0" start
    ;;

  status)
    if has_session; then
      say "进程：在跑（tmux 会话 $SESSION）"
    else
      say "进程：没跑"
    fi
    code=$(panel_code)
    if [ "$code" = "000" ]; then
      say "面板：没响应 (127.0.0.1:${PANEL_PORT})"
    else
      say "面板：HTTP $code  → http://127.0.0.1:${PANEL_PORT}"
    fi
    say "中继：AstrBot 侧在 ${ASTRBOT_WS_PORT:-6199} 等 ArkDroid 连过来"
    ;;

  log)
    if ! has_session; then
      bad "没在跑；如果启动过，看 /root/astrbot.log"
      exit 1
    fi
    exec proot-distro login "$DISTRO" --shared-tmp -- /bin/bash -lc \
      "tmux attach -t $SESSION"
    ;;

  tail)
    in_distro "tail -n ${2:-120} /root/astrbot.log"
    ;;

  shell)
    exec proot-distro login "$DISTRO" --shared-tmp -- /bin/bash -l
    ;;

  update)
    say "更新 AstrBot…"
    in_distro "cd /root/AstrBot && (git pull --ff-only || true) && uv sync" \
      && ok "更新完成，记得 astr restart"
    ;;

  uninstall)
    "$0" stop >/dev/null 2>&1 || true
    rm -f "$PREFIX/bin/astr"
    ok "已移除 astr 命令"
    say "~/AstrBot（在 rootfs 内）与 $DISTRO 都保留着，要彻底删："
    say "  proot-distro remove $DISTRO"
    ;;

  ""|-h|--help|help)
    cat <<'EOT'
astr —— AstrBot on Termux 的托管命令

  astr start      启动（后台 tmux 会话，等到面板可访问才返回）
  astr stop       停止
  astr restart    重启
  astr status     看进程与面板端口
  astr log        进入会话看实时输出（Ctrl+b 然后 d 退出，不会停）
  astr tail [n]   看最近 n 行日志文件
  astr shell      进 Ubuntu
  astr update     git pull + uv sync
  astr uninstall  移除命令（不删数据）
EOT
    ;;

  *)
    bad "不认识的子命令：$1"
    "$0" help
    exit 2
    ;;
esac
